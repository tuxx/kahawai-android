<?xml version="1.0" encoding="utf-8"?>
<!--
  Based on media3-ui's exo_player_control_view.xml (1.11.1), restyled:
  large rewind / play-pause / forward in the centre (media3's own ids, so
  PlayerControlView labels and wires them), the seek bar full width above
  a bottom row of labelled actions (Episodes, Audio & subtitles, Next
  episode), and back / title / settings across the top. Media3 doesn't
  expose a public hook to add entries into its own controls row, so
  app:controller_layout_id (pointing here) is the officially documented way
  to customize it; if media3-ui's control layout changes in a future
  version bump, this file needs to be re-diffed against the new one.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <View android:id="@id/exo_controls_background"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="@drawable/kw_player_scrim"/>

  <FrameLayout android:id="@id/exo_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_bottom_bar_height"
      android:layout_marginTop="@dimen/exo_styled_bottom_bar_margin_top"
      android:layout_gravity="bottom"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:background="@android:color/transparent"
      android:layoutDirection="ltr">

    <LinearLayout android:id="@id/exo_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:paddingStart="@dimen/exo_styled_bottom_bar_time_padding"
        android:paddingEnd="@dimen/exo_styled_bottom_bar_time_padding"
        android:paddingLeft="@dimen/exo_styled_bottom_bar_time_padding"
        android:paddingRight="@dimen/exo_styled_bottom_bar_time_padding"
        android:layoutDirection="ltr"
        android:importantForAccessibility="noHideDescendants">

      <TextView android:id="@id/exo_position"
          style="@style/ExoStyledControls.TimeText.Position"/>

      <TextView
          style="@style/ExoStyledControls.TimeText.Separator"/>

      <TextView android:id="@id/exo_duration"
          style="@style/ExoStyledControls.TimeText.Duration"/>

      <TextView android:id="@+id/kw_ends_at_separator"
          style="@style/ExoStyledControls.TimeText.Separator"
          android:visibility="gone"/>

      <!-- Populated/refreshed from PlayerScreen's AndroidView effects
           (see kw_ends_at handling there) - media3-ui only knows how to
           fill exo_position/exo_duration itself. Starts empty/gone so
           live streams (no known duration) never show a dangling
           separator with nothing after it. -->
      <TextView android:id="@+id/kw_ends_at"
          style="@style/ExoStyledControls.TimeText.Duration"
          android:text=""
          android:visibility="gone"/>

    </LinearLayout>

    <!-- media3's own id: PlayerControlViewLayoutManager moves these
         children into exo_extra_controls behind the overflow button when
         they don't fit, and expects exo_overflow_show to stay last.
         PlayerScreen drops the action labels on narrow screens first, so
         that should only happen on very small ones. -->
    <LinearLayout android:id="@id/exo_basic_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

      <ImageButton android:id="@id/exo_vr"
          style="@style/ExoStyledControls.Button.Bottom.VR"/>

      <ImageButton android:id="@id/exo_shuffle"
          style="@style/ExoStyledControls.Button.Bottom.Shuffle"/>

      <ImageButton android:id="@id/exo_repeat_toggle"
          style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"/>

      <!-- Custom ids throughout: media3 has no notion of a show's
           episodes, and every session is a single MediaItem, so its own
           exo_next would only ever be disabled. PlayerScreen owns their
           visibility and clicks. -->
      <!-- Up from this row is the seek bar; see the focus map above
           exo_top_controls. -->
      <LinearLayout android:id="@+id/kw_episodes"
          style="@style/KwPlayerAction"
          android:nextFocusUp="@id/exo_progress"
          android:visibility="gone"
          android:contentDescription="@string/player_episodes">
        <ImageView style="@style/KwPlayerAction.Icon"
            android:src="@drawable/kw_ic_episodes"/>
        <TextView android:id="@+id/kw_episodes_label"
            style="@style/KwPlayerAction.Label"
            android:text="@string/player_episodes"/>
      </LinearLayout>

      <LinearLayout android:id="@+id/kw_audio_subtitles"
          style="@style/KwPlayerAction"
          android:nextFocusUp="@id/exo_progress"
          android:contentDescription="@string/player_panel_audio_subtitles">
        <ImageView style="@style/KwPlayerAction.Icon"
            android:src="@drawable/kw_ic_subtitles"/>
        <TextView android:id="@+id/kw_audio_subtitles_label"
            style="@style/KwPlayerAction.Label"
            android:text="@string/player_panel_audio_subtitles"/>
      </LinearLayout>

      <LinearLayout android:id="@+id/kw_next_episode"
          style="@style/KwPlayerAction"
          android:nextFocusUp="@id/exo_progress"
          android:visibility="gone"
          android:contentDescription="@string/player_next_episode">
        <ImageView style="@style/KwPlayerAction.Icon"
            android:src="@drawable/kw_ic_skip_next"/>
        <TextView android:id="@+id/kw_next_episode_label"
            style="@style/KwPlayerAction.Label"
            android:text="@string/player_next_episode"/>
      </LinearLayout>

      <ImageButton android:id="@id/exo_fullscreen"
          style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

      <ImageButton android:id="@id/exo_overflow_show"
          style="@style/ExoStyledControls.Button.Bottom.OverflowShow"/>

    </LinearLayout>

    <HorizontalScrollView android:id="@id/exo_extra_controls_scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:visibility="invisible">

      <LinearLayout android:id="@id/exo_extra_controls"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layoutDirection="ltr">

        <ImageButton android:id="@id/exo_overflow_hide"
            style="@style/ExoStyledControls.Button.Bottom.OverflowHide"/>

      </LinearLayout>

    </HorizontalScrollView>

  </FrameLayout>

  <!-- Our own time bar rather than media3's exo_progress_placeholder
       (which it would swap for a DefaultTimeBar of its own): it shades
       what a seek can reach instantly instead of everything left of the
       playhead. The stock played/buffered fills are turned off here -
       they both start at the bar's left edge, which is the whole problem
       - and its unplayed colour with them, since it only ever draws that
       from the playhead rightward. SeekWindowTimeBar paints the whole
       length itself. -->
  <com.kolktech.kahawai.ui.player.SeekWindowTimeBar android:id="@id/exo_progress"
      android:nextFocusUp="@+id/kw_skip"
      android:nextFocusDown="@id/kw_audio_subtitles"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_progress_layout_height"
      android:layout_gravity="bottom"
      android:layout_marginBottom="@dimen/exo_styled_progress_margin_bottom"
      android:layout_marginStart="8dp"
      android:layout_marginEnd="8dp"
      app:played_color="@android:color/transparent"
      app:buffered_color="@android:color/transparent"
      app:unplayed_color="@android:color/transparent"/>

  <!-- Rewind / play-pause / forward. No exo_prev/exo_next: episodes are
       the bottom row's business (see kw_episodes/kw_next_episode). -->
  <LinearLayout android:id="@id/exo_center_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@android:color/transparent"
      android:gravity="center"
      android:padding="@dimen/exo_styled_controls_padding"
      android:clipToPadding="false"
      android:layoutDirection="ltr">

    <!-- singleLine="false" as in media3's own include, to avoid
         https://github.com/androidx/media/issues/511. -->
    <Button android:id="@id/exo_rew_with_amount"
        android:nextFocusUp="@id/kw_home"
        android:nextFocusDown="@id/kw_skip"
        android:singleLine="false"
        style="@style/KwPlayerCenter.Rewind"/>

    <ImageButton android:id="@id/exo_play_pause"
        android:nextFocusUp="@id/kw_home"
        android:nextFocusDown="@id/kw_skip"
        style="@style/KwPlayerCenter.PlayPause"/>

    <Button android:id="@id/exo_ffwd_with_amount"
        android:nextFocusUp="@id/exo_settings"
        android:nextFocusDown="@id/kw_skip"
        android:singleLine="false"
        style="@style/KwPlayerCenter.Forward"/>

  </LinearLayout>

  <!-- Skip recap/intro/credits, or Next episode: the controller's copy of
       the pill PlayerScreen floats over the video while the controls are
       hidden, at the same spot, so it's a real controller child the D-pad
       can reach (and lands on first) for as long as the offer lasts.
       PlayerScreen sets its label, icon, visibility and click. Its bottom
       margin clears the seek bar: progress margin + height + 8dp. -->
  <Button android:id="@id/kw_skip"
      android:nextFocusUp="@id/exo_play_pause"
      android:nextFocusDown="@id/exo_progress"
      style="@style/KwPlayerSkip"
      android:layout_gravity="bottom|end"
      android:layout_marginEnd="19dp"
      android:layout_marginBottom="103dp"
      android:visibility="gone"/>

  <LinearLayout android:id="@id/exo_minimal_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_marginBottom="@dimen/exo_styled_minimal_controls_margin_bottom"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layoutDirection="ltr">

    <ImageButton android:id="@id/exo_minimal_fullscreen"
        style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

  </LinearLayout>

  <!-- Back button, title and settings live here (not in a Compose
       overlay) because exo_top_controls is one of the views
       PlayerControlViewLayoutManager alpha-animates together with the
       background and bottom bar, so they fade in/out in perfect sync with
       the rest of the controls — and, as real controller children,
       they're reachable by D-pad focus on TV.

       D-pad focus map, top to bottom. Spatial search alone wanders here:
       the rows are different widths and the top bar's buttons sit far
       from the centre controls, so Up from play/pause found nothing.

         back -> home        settings      (Down from any: play/pause;
                                            Up/Left from home: back)
         rewind  play/pause  forward       (Up: home, home, settings)
         skip pill, while offered          (Down from centre lands here)
         seek bar                          (Left/Right seek)
         episodes  audio & subtitles  next (Up: seek bar)

       A Down/Up target that's gone (no skip offer) passes the move on
       along its own nextFocus in the same direction. -->
  <LinearLayout
      android:id="@+id/exo_top_controls"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="top"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:padding="16dp"
      android:background="@android:color/transparent">

    <ImageButton
        android:id="@+id/kw_back"
        android:nextFocusRight="@+id/kw_home"
        android:nextFocusDown="@+id/kw_home"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:background="@drawable/kw_circle_button_bg"
        android:src="@drawable/kw_ic_arrow_back"
        android:contentDescription="@string/kw_back"/>

    <!-- Straight to Home, past whatever detail/season pages are stacked
         under the player (see NavGraph's onHome). -->
    <ImageButton
        android:id="@+id/kw_home"
        android:nextFocusUp="@id/kw_back"
        android:nextFocusLeft="@id/kw_back"
        android:nextFocusDown="@id/exo_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:background="@drawable/kw_circle_button_bg"
        android:src="@drawable/kw_ic_home"
        android:contentDescription="@string/kw_home"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

      <TextView
          android:id="@+id/kw_player_title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="@android:color/white"
          android:textSize="17sp"
          android:textStyle="bold"
          android:maxLines="1"
          android:ellipsize="end"/>

      <TextView
          android:id="@+id/kw_player_subtitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#B3FFFFFF"
          android:textSize="13sp"
          android:maxLines="1"
          android:ellipsize="end"
          android:visibility="gone"/>

    </LinearLayout>

    <View
        android:id="@+id/exo_media_route_button_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <!-- media3's id, but PlayerScreen takes over its click to open the
         side panel instead of media3's own settings menu. -->
    <ImageButton
        android:id="@id/exo_settings"
        android:nextFocusLeft="@id/kw_home"
        android:nextFocusDown="@id/exo_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:background="@drawable/kw_circle_button_bg"
        android:src="@drawable/exo_styled_controls_settings"
        android:contentDescription="@string/exo_controls_settings_description"/>
  </LinearLayout>

</merge>
