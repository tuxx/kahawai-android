<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy of media3-ui's exo_player_control_view.xml (1.10.0) with the center
  controls block (prev/rewind/play/ffwd/next) removed and small
  prev/play-pause/next buttons placed at the start of the bottom bar
  instead, before the time display. Audio track selection lives in the
  settings gear menu (see PlayerScreen's showSettingsMenu), not as its own
  bottom-bar button — portrait screens don't have the width. Media3 doesn't
  expose a public hook to add entries into its own controls row, so
  app:controller_layout_id (pointing here) is the officially documented way
  to customize it; if media3-ui's control layout changes in a future
  version bump, this file needs to be re-diffed against the new one.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <View android:id="@id/exo_controls_background"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="@color/exo_black_opacity_60"/>

  <FrameLayout android:id="@id/exo_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_bottom_bar_height"
      android:layout_marginTop="@dimen/exo_styled_bottom_bar_margin_top"
      android:layout_gravity="bottom"
      android:background="@color/exo_bottom_bar_background"
      android:layoutDirection="ltr">

    <LinearLayout android:id="@+id/kw_bottom_start_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

      <!-- kw_prev/kw_next (not exo_prev/exo_next): PlayerControlView only
           wires up its own previous/next-episode navigation, dimming and
           auto managing enabled state based on the player's own timeline
           (COMMAND_SEEK_TO_PREVIOUS/NEXT) rather than the actual show's
           adjacent episodes — since every session is a single MediaItem,
           that left "<" just restarting the current item and ">"
           permanently disabled. findViewById(R.id.exo_prev/exo_next) is
           null-guarded in PlayerControlView, so giving these custom ids
           opts them out of that management entirely; PlayerScreen owns
           their visibility and click handling instead (see
           adjacentEpisodes wiring). -->
      <ImageButton android:id="@+id/kw_prev"
          style="@style/ExoStyledControls.Button.Bottom"
          android:src="@drawable/exo_styled_controls_previous"
          android:scaleType="fitCenter"
          android:visibility="gone"
          android:contentDescription="@string/exo_controls_previous_description"/>

      <ImageButton android:id="@id/exo_play_pause"
          style="@style/ExoStyledControls.Button.Bottom"
          android:src="@drawable/exo_styled_controls_play"
          android:scaleType="fitCenter"
          android:contentDescription="@string/exo_controls_play_description"/>

      <ImageButton android:id="@+id/kw_next"
          style="@style/ExoStyledControls.Button.Bottom"
          android:src="@drawable/exo_styled_controls_next"
          android:scaleType="fitCenter"
          android:visibility="gone"
          android:contentDescription="@string/exo_controls_next_description"/>

      <LinearLayout android:id="@id/exo_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="@dimen/exo_styled_bottom_bar_time_padding"
          android:paddingEnd="@dimen/exo_styled_bottom_bar_time_padding"
          android:paddingLeft="@dimen/exo_styled_bottom_bar_time_padding"
          android:paddingRight="@dimen/exo_styled_bottom_bar_time_padding"
          android:layoutDirection="ltr"
          android:importantForAccessibility="noHideDescendants">

        <TextView android:id="@id/exo_position"
            style="@style/ExoStyledControls.TimeText.Position"/>

        <TextView
            style="@style/ExoStyledControls.TimeText.Separator"/>

        <TextView android:id="@id/exo_duration"
            style="@style/ExoStyledControls.TimeText.Duration"/>

        <TextView android:id="@+id/kw_ends_at_separator"
            style="@style/ExoStyledControls.TimeText.Separator"
            android:visibility="gone"/>

        <!-- Populated/refreshed from PlayerScreen's AndroidView effects
             (see kw_ends_at handling there) - media3-ui only knows how to
             fill exo_position/exo_duration itself. Starts empty/gone so
             live streams (no known duration) never show a dangling
             separator with nothing after it. -->
        <TextView android:id="@+id/kw_ends_at"
            style="@style/ExoStyledControls.TimeText.Duration"
            android:text=""
            android:visibility="gone"/>

      </LinearLayout>

    </LinearLayout>

    <LinearLayout android:id="@id/exo_basic_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layoutDirection="ltr">

      <ImageButton android:id="@id/exo_vr"
          style="@style/ExoStyledControls.Button.Bottom.VR"/>

      <ImageButton android:id="@id/exo_shuffle"
          style="@style/ExoStyledControls.Button.Bottom.Shuffle"/>

      <ImageButton android:id="@id/exo_repeat_toggle"
          style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"/>

      <ImageButton android:id="@+id/kw_subtitle"
          android:contentDescription="@string/subtitles"
          android:enabled="false"
          style="@style/ExoStyledControls.Button.Bottom.CC"/>

      <ImageButton android:id="@id/exo_settings"
          style="@style/ExoStyledControls.Button.Bottom.Settings"/>

      <ImageButton android:id="@id/exo_fullscreen"
          style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

      <ImageButton android:id="@id/exo_overflow_show"
          style="@style/ExoStyledControls.Button.Bottom.OverflowShow"/>

    </LinearLayout>

    <HorizontalScrollView android:id="@id/exo_extra_controls_scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:visibility="invisible">

      <LinearLayout android:id="@id/exo_extra_controls"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layoutDirection="ltr">

        <ImageButton android:id="@id/exo_overflow_hide"
            style="@style/ExoStyledControls.Button.Bottom.OverflowHide"/>

      </LinearLayout>

    </HorizontalScrollView>

  </FrameLayout>

  <!-- Our own time bar rather than media3's exo_progress_placeholder
       (which it would swap for a DefaultTimeBar of its own): it shades
       what a seek can reach instantly instead of everything left of the
       playhead. The stock played/buffered fills are turned off here -
       they both start at the bar's left edge, which is the whole problem
       - and its unplayed colour with them, since it only ever draws that
       from the playhead rightward. SeekWindowTimeBar paints the whole
       length itself. -->
  <com.kolktech.kahawai.ui.player.SeekWindowTimeBar android:id="@id/exo_progress"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_progress_layout_height"
      android:layout_gravity="bottom"
      android:layout_marginBottom="@dimen/exo_styled_progress_margin_bottom"
      app:played_color="@android:color/transparent"
      app:buffered_color="@android:color/transparent"
      app:unplayed_color="@android:color/transparent"/>

  <LinearLayout android:id="@id/exo_minimal_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_marginBottom="@dimen/exo_styled_minimal_controls_margin_bottom"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layoutDirection="ltr">

    <ImageButton android:id="@id/exo_minimal_fullscreen"
        style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

  </LinearLayout>

  <!-- Back button + title live here (not in a Compose overlay) because
       exo_top_controls is one of the views PlayerControlViewLayoutManager
       alpha-animates together with the background and bottom bar, so they
       fade in/out in perfect sync with the rest of the controls — and, as
       real controller children, they're reachable by D-pad focus on TV. -->
  <LinearLayout
      android:id="@+id/exo_top_controls"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="top"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:padding="16dp"
      android:background="@android:color/transparent">

    <ImageButton
        android:id="@+id/kw_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:background="@drawable/kw_circle_button_bg"
        android:src="@drawable/kw_ic_arrow_back"
        android:contentDescription="@string/kw_back"/>

    <TextView
        android:id="@+id/kw_player_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"/>

    <View
        android:id="@+id/exo_media_route_button_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>
  </LinearLayout>

</merge>
